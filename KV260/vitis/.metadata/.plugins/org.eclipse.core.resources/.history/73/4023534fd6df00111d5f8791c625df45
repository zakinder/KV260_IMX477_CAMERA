#define UDP_BUFF_SIZE 1400
/* KV26 UDP v1: 20-byte network-order header, then BMP bytes. */
#define KV26_HEADER_SIZE 20U
#define KV26_TOTAL_PACKETS (1U + ((VIDEO2_MAX_FRAME + UDP_BUFF_SIZE - 1U) / UDP_BUFF_SIZE))
static struct udp_pcb *udp8080_pcb = NULL;
static u32 kv26_frame_id = 0;
extern ip_addr_t target_addr;
static void kv26_put16(u8 *p, u16 v) { p[0] = (u8)(v >> 8); p[1] = (u8)v; }
static void kv26_put32(u8 *p, u32 v) {
    p[0] = (u8)(v >> 24); p[1] = (u8)(v >> 16);
    p[2] = (u8)(v >> 8); p[3] = (u8)v;
}
static int kv26_send(u32 frame_id, u32 packet_id, u16 total,
                     const void *payload, u16 length)
{
    struct pbuf *p;
    u8 *d;
    err_t err;
    if (udp8080_pcb == NULL || payload == NULL || length > UDP_BUFF_SIZE)
        return -1;
    p = pbuf_alloc(PBUF_TRANSPORT, (u16)(KV26_HEADER_SIZE + length), PBUF_RAM);
    if (!p) return -2;
    d = (u8 *)p->payload;
    d[0] = 'K'; d[1] = 'V'; d[2] = '2'; d[3] = '6';
    d[4] = 1; d[5] = 0;
    kv26_put16(d + 6, KV26_HEADER_SIZE);
    kv26_put32(d + 8, frame_id);
    kv26_put32(d + 12, packet_id);
    kv26_put16(d + 16, total);
    kv26_put16(d + 18, length);
    memcpy(d + KV26_HEADER_SIZE, payload, length);
    err = udp_sendto(udp8080_pcb, p, &target_addr, 8080);
    pbuf_free(p);
    return err == ERR_OK ? 0 : (int)err;
}

