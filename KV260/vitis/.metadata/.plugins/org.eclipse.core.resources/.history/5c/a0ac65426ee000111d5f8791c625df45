#include "jpeg_snapshot.h"
#include "../config.h"
#include "xil_cache.h"
#include "xil_io.h"
#include "xparameters.h"
#include "xaxivdma.h"
#include "xtime_l.h"
#include <stdio.h>
#include <string.h>

#define STB_IMAGE_WRITE_IMPLEMENTATION
#define STB_IMAGE_WRITE_STATIC
#define STBI_WRITE_NO_STDIO
#include "stb_image_write.h"

#define JPEG_CAPACITY (8U * 1024U * 1024U)
#define JPEG_QUALITY 75
/* Match the existing BMP preview: low byte blue, and vflip for upright output.
 * Set either to 0 if your bitstream's pixel packing differs. */
#define JPEG_SOURCE_BGR 1
#define JPEG_FLIP_VERTICAL 1

#define PARK_PTR 0x28U
#define S2MM_CONTROL 0x30U
#define S2MM_STATUS 0x34U
#define S2MM_FRAME_IRQ (1U << 12)
#define S2MM_ERROR_BITS 0xC9F0U
#define S2MM_CLEARABLE_ERRORS 0xC990U
#define WRITE_REFERENCE_MASK (31U << 8)
#define WRITE_STORE(value) (((value) >> 24) & 31U)

extern u32 *pFrames[DISPLAY_NUM_FRAMES];
static unsigned char pixels[VIDEO1_MAX_FRAME];
static unsigned char jpeg[JPEG_CAPACITY];

struct jpeg_output {
    size_t size;
    int overflow;
};

static void collect_jpeg(void *context, void *data, int length)
{
    struct jpeg_output *out = context;
    if (out->overflow || length < 0 || (size_t)length > sizeof(jpeg) - out->size) {
        out->overflow = 1;
        return;
    }
    memcpy(jpeg + out->size, data, (size_t)length);
    out->size += (size_t)length;
}

static int wait_register(UINTPTR address, u32 mask, u32 value)
{
    XTime started, now;
    XTime_GetTime(&started);
    do {
        if ((Xil_In32(address) & mask) == value)
            return 1;
        XTime_GetTime(&now);
    } while (now - started < COUNTS_PER_SECOND);
    return 0;
}

static void park_write(UINTPTR base, unsigned int store)
{
    u32 park = Xil_In32(base + PARK_PTR);
    Xil_Out32(base + PARK_PTR, (park & ~WRITE_REFERENCE_MASK) | (store << 8));
}

static int snapshot_store(UINTPTR base, unsigned int *store)
{
    u32 park = Xil_In32(base + PARK_PTR);
    unsigned int original = (park >> 8) & 31U;
    unsigned int video_read = park & 31U;
    unsigned int spare;
    u32 status;

    /* This firmware parks both VDMA channels. Don't borrow the DP graphics
     * buffer (store 1), or the active video read/write stores. */
    if ((Xil_In32(base + S2MM_CONTROL) & 3U) != 1U ||
        (Xil_In32(base) & 3U) != 1U ||
        original >= DISPLAY_NUM_FRAMES || WRITE_STORE(park) != original)
        return 0;
    for (spare = 0; spare < DISPLAY_NUM_FRAMES; ++spare)
        if (spare != original && spare != video_read && spare != 1)
            break;
    if (spare == DISPLAY_NUM_FRAMES)
        return 0;

    /* Clear only documented W1C frame/error bits to observe this capture. */
    Xil_Out32(base + S2MM_STATUS, S2MM_FRAME_IRQ | S2MM_CLEARABLE_ERRORS);
    Xil_DCacheFlushRange((UINTPTR)pFrames[spare], VIDEO1_MAX_FRAME);
    park_write(base, spare);
    int switched = wait_register(base + PARK_PTR, 31U << 24, spare << 24);
    int completed = 0;
    if (switched) {
        Xil_Out32(base + S2MM_STATUS, S2MM_FRAME_IRQ);
        completed = wait_register(base + S2MM_STATUS, S2MM_FRAME_IRQ, S2MM_FRAME_IRQ);
    }
    park_write(base, original);
    int restored = wait_register(base + PARK_PTR, 31U << 24, original << 24);
    status = Xil_In32(base + S2MM_STATUS);
    if (!completed || !restored || (status & S2MM_ERROR_BITS)) {
        printf("JPEG VDMA capture failed: switched=%d complete=%d restored=%d status=%08lX\r\n",
               switched, completed, restored, (unsigned long)status);
        return 0;
    }
    *store = spare;
    return 1;
}

size_t jpeg_snapshot_capture(const unsigned char **data)
{
    struct jpeg_output out = {0, 0};
    XAxiVdma_Config *config = XAxiVdma_LookupConfig(XPAR_AXIVDMA_0_DEVICE_ID);
    unsigned int store;
    XTime start, end;

    if (VIDEO1_COLUMNS != 3840 || VIDEO1_ROWS != 2160 ||
        !config || !snapshot_store(config->BaseAddress, &store)) {
        printf("JPEG requires the working 4K parked VDMA configuration.\r\n");
        return 0;
    }
    Xil_DCacheInvalidateRange((UINTPTR)pFrames[store], VIDEO1_MAX_FRAME);
    const unsigned char *frame = (const unsigned char *)pFrames[store];
    for (unsigned int y = 0; y < VIDEO1_ROWS; ++y) {
        unsigned int source_y = JPEG_FLIP_VERTICAL ? VIDEO1_ROWS - 1U - y : y;
        const unsigned char *source = frame + source_y * VIDEO1_STRIDE;
        unsigned char *destination = pixels + y * VIDEO1_STRIDE;
        for (unsigned int x = 0; x < VIDEO1_COLUMNS; ++x) {
            destination[0] = source[JPEG_SOURCE_BGR ? 2 : 0];
            destination[1] = source[1];
            destination[2] = source[JPEG_SOURCE_BGR ? 0 : 2];
            source += 3;
            destination += 3;
        }
    }

    XTime_GetTime(&start);
    if (!stbi_write_jpg_to_func(collect_jpeg, &out, VIDEO1_COLUMNS, VIDEO1_ROWS,
                               3, pixels, JPEG_QUALITY) || out.overflow) {
        printf("JPEG encoding failed or exceeded the output buffer.\r\n");
        return 0;
    }
    XTime_GetTime(&end);
    printf("JPEG 3840x2160: %lu bytes, encode %lu ms\r\n",
           (unsigned long)out.size,
           (unsigned long)((end - start) * 1000U / COUNTS_PER_SECOND));
    *data = jpeg;
    return out.size;
}
