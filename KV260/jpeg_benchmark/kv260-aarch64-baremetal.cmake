set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES KV260_TOOLCHAIN_BIN)

set(KV260_TOOLCHAIN_BIN "" CACHE PATH "Vitis aarch64-none-elf toolchain bin directory")
if(NOT KV260_TOOLCHAIN_BIN)
    message(FATAL_ERROR "Set KV260_TOOLCHAIN_BIN to the bin directory used by Vitis")
endif()
set(CMAKE_C_COMPILER "${KV260_TOOLCHAIN_BIN}/aarch64-none-elf-gcc.exe")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${KV260_TOOLCHAIN_BIN}/aarch64-none-elf-ar.exe")
set(CMAKE_RANLIB "${KV260_TOOLCHAIN_BIN}/aarch64-none-elf-ranlib.exe")
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a53")
set(CMAKE_ASM_FLAGS_INIT "-mcpu=cortex-a53")
